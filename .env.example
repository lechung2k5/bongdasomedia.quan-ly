# ========================================================
# BÓNG ĐÁ SỐ MEDIA ERP - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# Database (PostgreSQL URL)
# Ví dụ trên Render / Supabase / Neon / Aiven:
DATABASE_URL="postgresql://username:password@host:5432/bongdaso_erp?sslmode=require"

# Security & App
NEXTAUTH_SECRET="replace-with-a-random-32-char-secret-string"
PORT=3000

# AWS S3 Storage (Upload ảnh bill, thiết bị, avatar, check-in)
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET="your_s3_bucket_name"

# Goong Maps API (Bản đồ & Định vị GPS)
NEXT_PUBLIC_GOONG_MAPTILES_KEY="your_goong_maptiles_key"
NEXT_PUBLIC_GOONG_API_KEY="your_goong_api_key"
GOONG_MAPTILES_KEY="your_goong_maptiles_key"
GOONG_API_KEY="your_goong_api_key"
